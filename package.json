{
  "name": "taletto-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "set:key": "node scripts/set-service-account.mjs",
    "check": "node --env-file=.env.local scripts/check-keys.mjs",
    "admin": "node --env-file=.env.local scripts/set-admin.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:classes"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "~13.10.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "^10.5.4",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "5.5.4"
  }
}
