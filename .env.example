# Copier en .env.local et remplir. Ce fichier-ci est versionne, .env.local non.

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Generer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Firebase : cle de compte de service (SECRETE) ---
# Console > Parametres du projet > Comptes de service > Generer une cle privee
# Coller le contenu du JSON sur UNE SEULE ligne.
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT=""

# --- Firebase : configuration Web (PUBLIQUE) ---
# Console > Parametres du projet > Vos applications > Application Web
# Ces valeurs partent dans le navigateur : c'est normal, elles identifient
# le projet sans rien autoriser par elles-memes.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
